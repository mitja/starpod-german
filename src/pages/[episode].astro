---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Schema } from 'astro-seo-schema';
import { marked } from 'marked';

import FormattedDate from '../components/FormattedDate';
import CreatorsAndGuests from '../components/episode/CreatorsAndGuests.astro';
import PlayButton from '../components/player/PlayButton';
import FullPlayButton from '../components/FullPlayButton';
import UFOIllustration from '../components/illustrations/UFOIllustration.astro';
import Layout from '../layouts/Layout.astro';
import { getAllEpisodes, getShowInfo } from '../lib/rss';
// Import mockData as fallback
import { mockHostsAndGuests } from '../lib/mockData';

// Define types for hosts and guests
interface PersonDisplay {
  id: string;
  name: string;
  img: string | null;
  isHost: boolean;
}

const show = await getShowInfo();

export async function getStaticPaths() {
  const allEpisodes = await getAllEpisodes();

  return allEpisodes.flatMap((episode) => {
    return [
      {
        params: { episode: episode.episodeNumber },
        props: { episode }
      },
      {
        params: { episode: episode.episodeSlug },
        props: { episode }
      }
    ];
  });
}

const { episode } = Astro.props;

// Get all transcripts
const allTranscripts = await getCollection('transcripts');

// Try to get people collection, but handle the case where it might not exist yet
let allPeople: CollectionEntry<'people'>[] = [];
try {
  allPeople = await getCollection('people');
} catch (error) {
  console.log('People collection not found, using fallback data');
}

// Try to find a transcript by episode number
let transcriptEntry: CollectionEntry<'transcripts'> | undefined;
let transcriptHtml: string | null = null;
let hostsAndGuests: PersonDisplay[] = [];

if (episode.episodeNumber && episode.episodeNumber !== 'Bonus') {
  try {
    // First try exact match with episode number
    transcriptEntry = allTranscripts.find(
      t => t.id === episode.episodeNumber || 
           t.data.episodeNumber === episode.episodeNumber
    );
    
    // If not found, try with slug
    if (!transcriptEntry) {
      transcriptEntry = allTranscripts.find(
        t => t.slug === episode.episodeSlug
      );
    }
    
    // If found, parse the markdown content directly to HTML and get hosts/guests
    if (transcriptEntry) {
      // Get the raw markdown content and convert it to HTML
      transcriptHtml = await marked.parse(transcriptEntry.body);
      
      // Try to get hosts and guests from the transcript frontmatter
      if (allPeople.length > 0 && transcriptEntry.data) {
        const { hosts = [], guests = [] } = transcriptEntry.data;
        
        // Map host IDs to full people objects
        const hostObjects = hosts
          .map(hostId => allPeople.find(p => p.id === hostId))
          .filter(Boolean)
          .map(host => ({
            id: host!.id,
            name: host!.data.name,
            img: host!.data.img || null,
            isHost: true
          }));
        
        // Map guest IDs to full people objects
        const guestObjects = guests
          .map(guestId => allPeople.find(p => p.id === guestId))
          .filter(Boolean)
          .map(guest => ({
            id: guest!.id,
            name: guest!.data.name,
            img: guest!.data.img || null,
            isHost: false
          }));
        
        // Combine hosts and guests
        hostsAndGuests = [...hostObjects, ...guestObjects];
      }
    }
  } catch (error) {
    console.error(`Error loading transcript for episode ${episode.episodeNumber}:`, error);
  }
}

// If no hosts/guests found in transcript, look for any hosts in the people collection
if (hostsAndGuests.length === 0) {
  if (allPeople.length > 0) {
    const defaultHosts = allPeople
      .filter(person => person.data.isHost)
      .map(host => ({
        id: host.id,
        name: host.data.name,
        img: host.data.img || null,
        isHost: true
      }));
    
    hostsAndGuests = defaultHosts;
  } else {
    // Fallback to mock data if people collection doesn't exist yet
    hostsAndGuests = mockHostsAndGuests;
  }
}

const canonicalURL = new URL(`/${episode.episodeSlug}`, Astro.url);

const title = `${episode.title} - ${show.title} - Episode ${episode.episodeNumber}`;
---

<Layout
  canonicalURL={canonicalURL}
  description={episode.description}
  imageUrl={episode.episodeImage}
  title={title}
>
  <Schema
    slot="head"
    item={{
      '@context': 'https://schema.org',
      '@type': 'PodcastEpisode',
      name: episode.title,
      datePublished: new Date(episode.published).toISOString(),
      description: episode.description,
      episodeNumber: episode.episodeNumber
    }}
  />

  <div class="relative z-10 px-8 lg:px-18">
    <div class="block lg:flex">
      <div class="mr-11 mt-4 hidden lg:block">
        <PlayButton client:load episode={episode} />
      </div>

      <div class="overflow-hidden break-words">
        <FormattedDate date={new Date(episode.published)} />

        <h1
          class="mb-4 text-2xl font-bold text-light-text-heading lg:mb-6 lg:text-5xl dark:text-white"
        >
          {episode.episodeNumber}: {episode.title}
        </h1>

        <p class="mb-8 lg:mb-12">
          {episode.description}
        </p>

        <div class="mb-8 block lg:hidden">
          <FullPlayButton client:load episode={episode} />
        </div>

        {
          hostsAndGuests?.length ? (
            <CreatorsAndGuests hostsAndGuests={hostsAndGuests} />
          ) : undefined
        }

        <h3 class="section-heading-underlined mb-8 mt-16">Show Notes</h3>

        <div
          class="prose prose-neutral mb-5 dark:prose-invert [&>h2:nth-of-type(3n)]:before:bg-violet-200 [&>h2:nth-of-type(3n+2)]:before:bg-indigo-200 [&>h2]:mt-12 [&>h2]:flex [&>h2]:items-center [&>h2]:font-mono [&>h2]:text-sm [&>h2]:font-medium [&>h2]:leading-7 [&>h2]:text-slate-900 [&>h2]:before:mr-3 [&>h2]:before:h-3 [&>h2]:before:w-1.5 [&>h2]:before:rounded-r-full [&>h2]:before:bg-cyan-200 [&>ul]:mt-6 [&>ul]:pl-5"
        >
          <Fragment set:html={episode.content} />
        </div>

        <h3 class="section-heading-underlined mb-8 mt-16">
          Transcript
        </h3>

        {
          transcriptHtml ? (
            <div class="mb-20">
              <article class="transcript prose prose-neutral line-clamp-4 dark:prose-invert">
                {/* Use Fragment to insert the HTML */}
                <Fragment set:html={transcriptHtml} />
              </article>

              <button
                class="btn mt-4"
                type="button"
                onclick="document.querySelector('.transcript').classList.remove('line-clamp-4'); this.classList.add('hidden');"
              >
                <span class="px-8 py-3">Zeige mehr</span>
              </button>
            </div>
          ) : (
            <div class="flex flex-col items-center">
              <div class="h-auto w-full max-w-80">
                <UFOIllustration />
              </div>

              <p class="py-10 text-lg font-bold text-light-text-heading dark:text-white">
                Für diese Episode gibt es kein Transcript.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</Layout>
