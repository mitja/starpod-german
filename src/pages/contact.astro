---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
---

<Layout title="Kontakt">
  <div class="relative z-10 px-8 lg:px-18">
    <h1
      class="mb-4 text-2xl font-bold text-light-text-heading lg:mb-6 lg:text-5xl dark:text-white"
    >
      Hallo 👋
    </h1>

    <p class="mb-8">
      Hast du ein spannendes Thema, Feedback, oder eine Frage?<br>
      Schreib mir eine Nachricht! Ich melde mich dann bei dir.
    </p>

    <p class="mb-8">
      Meine E-Mail Adresse ist <a href="mailto:hi@mitjamartini.com">hi@mitjamartini.com</a>
      <br>
      Oder per Post: Mitja Martini, Helmkrautstr. 32, 13503 Berlin
    </p>
    <!--<ContactForm client:load /> -->
  </div>
</Layout>
