---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
  hostsAndGuests: Array<{
    id: string;
    img: string | null;
    isHost: boolean;
    name: string;
  }>;
}

const { hostsAndGuests } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/img/*.{jpeg,jpg,png}'
);
const priorityNames = ['Mitja Martini'];
---

<h3 class="section-heading pb-6">Podcaster</h3>

<div class="mb-12 grid grid-cols-1 gap-4 lg:mb-20 lg:grid-cols-2">
  {
    hostsAndGuests.sort((a, b) => {
    // Check if `a` or `b` are in the priority list
    const aPriorityIndex = priorityNames.indexOf(a.name);
    const bPriorityIndex = priorityNames.indexOf(b.name);

    if (aPriorityIndex !== -1 && bPriorityIndex !== -1) {
      // If both names are in the priority list, maintain the priority order
      return aPriorityIndex - bPriorityIndex;
    }
    if (aPriorityIndex !== -1) {
      // If only `a` is in the priority list, it comes first
      return -1;
    }
    if (bPriorityIndex !== -1) {
      // If only `b` is in the priority list, it comes first
      return 1;
    }

    // Check for `isHost` flag
    if (a.isHost && !b.isHost) {
      return -1; // Hosts come before non-hosts
    }
    if (!a.isHost && b.isHost) {
      return 1; // Non-hosts come after hosts
    }

    // Sort remaining users alphabetically
    return a.name.localeCompare(b.name);
  }).map(async (person) => {
      // Handle image with safe fallbacks
      let personImage;
      if (person.img && images[`/src/img/${person.img}`]) {
        try {
          const { default: img } = await images[`/src/img/${person.img}`]();
          personImage = img;
        } catch (error) {
          console.error(`Error loading image for ${person.name}:`, error);
        }
      }

      // Get fallback images
      let lightFallbackImage, darkFallbackImage;
      try {
        const { default: lightImg } = await images['/src/img/avatar-light.png']();
        lightFallbackImage = lightImg;
        
        const { default: darkImg } = await images['/src/img/avatar-dark.png']();
        darkFallbackImage = darkImg;
      } catch (error) {
        console.error("Error loading fallback images:", error);
      }

      return (
        <div class="flex items-center">
          {personImage ? (
            <Image
              class="mr-4 h-12 w-12 rounded-lg"
              height={48}
              src={personImage}
              alt={`Foto von ${person.name}`}
              width={48}
            />
          ) : lightFallbackImage && darkFallbackImage ? (
            <>
              <Image
                class="mr-4 h-12 w-12 rounded-lg dark:hidden"
                height={48}
                src={lightFallbackImage}
                alt=""
                width={48}
              />
              <Image
                class="mr-4 hidden h-12 w-12 rounded-lg dark:block"
                height={48}
                src={darkFallbackImage}
                alt=""
                width={48}
              />
            </>
          ) : (
            <div class="mr-4 h-12 w-12 rounded-lg bg-gray-200 dark:bg-gray-700 flex items-center justify-center">
              <span class="text-gray-500 dark:text-gray-300 text-sm">{person.name.charAt(0)}</span>
            </div>
          )}
          {person.name}
        </div>
      );
    })
  }
</div>
