    "@astrojs/vercel": "^8.0.1",
    "@preact/signals": "^1.3.1",
    "astro": "^5.1.4",
    "astro-seo-schema": "^5.0.0",
    "atropos": "^2.0.2",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.7",
    "pnpm": "^10.5.2",
    "preact": "^10.25.1",
    "rss-to-json": "^2.1.1",
    "schema-dts": "^1.1.2",
    "sharp": "^0.33.2",
    "slugify": "^1.6.6",
    "valibot": "^0.31.1"
  },
  "devDependencies": {
